# Vercel Redis / Upstash Redis (Auto-provisioned via `vercel integration add upstash` or Vercel Storage)
UPSTASH_REDIS_REST_URL="https://your-redis-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# Optional Legacy / Vercel KV Storage env var names (also supported automatically)
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# X (Twitter) OAuth 2.0 Credentials (from https://developer.x.com/en/portal/dashboard)
TWITTER_CLIENT_ID="your_x_oauth2_client_id"
TWITTER_CLIENT_SECRET="your_x_oauth2_client_secret"
TWITTER_REDIRECT_URI="http://localhost:3000/api/auth/twitter/callback"

# Secret token to protect /api/cron/auto-follow endpoint
CRON_SECRET="x-auto-follow-secret-2026"
